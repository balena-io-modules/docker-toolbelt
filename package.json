{
  "name": "docker-toolbelt",
  "version": "7.1.6",
  "description": "Some tools for docker",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=22.22.0 <23.0.0 || >=24.13.0"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "lint": "balena-lint lib tests",
    "lint-fix": "balena-lint --fix lib tests",
    "pretest": "npm run build",
    "test": "npm run test:fast && npm run lint",
    "test:fast": "mocha --reporter spec tests/**/*.spec.ts",
    "doc": "typedoc lib/ && touch docs/.nojekyll",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balena-io-modules/docker-toolbelt.git"
  },
  "author": "Balena Ltd.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/balena-io-modules/docker-toolbelt/issues"
  },
  "homepage": "https://github.com/balena-io-modules/docker-toolbelt#readme",
  "dependencies": {
    "JSONStream": "^1.3.5",
    "randomstring": "^1.3.1",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@balena/lint": "^9.3.12",
    "@types/chai": "5.2.3",
    "@types/dockerode": "4.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/randomstring": "1.3.0",
    "chai": "6.3.0",
    "mocha": "12.0.3",
    "rimraf": "6.1.3",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  },
  "versionist": {
    "publishedAt": "2026-10-28T23:23:55.992Z"
  },
  "peerDependencies": {
    "dockerode": "^4.0.2 || ^5.0.0"
  }
}
